// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            // "shift shift": "file_finder::Toggle"
        },
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            // "j k": "vim::NormalBefore"
            "ctrl-l": "editor::MoveRight",
            "ctrl-h": "editor::MoveLeft",
            "ctrl-j": "editor::MoveDown",
            "ctrl-k": "editor::MoveUp",
            "alt-k": "editor::MoveUp",
            "alt-h": "editor::MoveToBeginningOfLine",
            "alt-l": "editor::MoveToEndOfLine",
        },
    },
    {
        "context": "Editor",
        "bindings": {
            "secondary-k d": "editor::Format",
            "ctrl-\\": "pane::SplitRight",
            "ctrl-alt-\\": "pane::SplitDown",
            "secondary-k c": "workspace::CopyRelativePath",
            "alt-d": "editor::SelectNext",
        },
    },
    {
        "context": "Editor && mode == full && !menu",
        "bindings": {
            "secondary-k secondary-o": "editor::SwitchSourceHeader",
        },
    },
    {
        "bindings": {
            "secondary-k [": "workspace::ToggleLeftDock",
            "secondary-k ]": "workspace::ToggleRightDock",
            "secondary-k a": "workspace::ToggleLeftDock",
            "secondary-k t": "terminal_panel::Toggle",
            "secondary-k secondary-]": "workspace::ToggleRightDock",
            "secondary-k secondary-[": "workspace::ToggleLeftDock",
            "secondary-k secondary-t": "terminal_panel::Toggle",
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "secondary-k o": [
                "pane::CloseOtherItems",
                {
                    "close_pinned": false,
                },
            ],
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "secondary-k h": [
                "pane::CloseItemsToTheLeft",
                {
                    "close_pinned": false,
                },
            ],
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "secondary-k l": [
                "pane::CloseItemsToTheRight",
                {
                    "close_pinned": false,
                },
            ],
        },
    },
    {
        "context": "!ContextEditor > (Editor && mode == full)",
        "bindings": {
            "secondary-[ s": "pane::RevealInProjectPanel",
        },
    },
    {
        "context": "VimControl && !menu",
        "bindings": {
            "g t": "vim::WindowTop",
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "alt->": "pane::ActivateNextItem",
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "alt-<": "pane::ActivatePreviousItem",
        },
    },
    {
        "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
        "unbind": {
            "g e": "vim::EndOfDocument",
        },
    },
    {
        "context": "Editor",
        "bindings": {
            "shift-space": "editor::ShowCompletions"
        }
    },
    {
        "context": "Editor",
        "unbind": {
            "ctrl-space": "editor::ShowCompletions"
        }
    },
    {
        "bindings": {
            "ctrl-alt-f": "text_finder::Toggle"
        }
    }
]
